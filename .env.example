# Server
PORT=8081

# Comma-separated list of allowed frontend origins.
# https://localhost is Capacitor's default Android/iOS WebView origin - keep it.
ALLOWED_ORIGINS=https://localhost,http://localhost:3000,http://localhost:5173

# Gemini API key (server-side only, never shipped to any client)
GEMINI_API_KEY=your-gemini-api-key-here

# Firebase Admin credentials - pick ONE approach:
#
# Option A (recommended for EC2/systemd): base64-encode the full service account JSON
# and paste it here as a single line.
#   Get the JSON from: Firebase Console > Project Settings > Service Accounts > Generate new private key
#   Encode it with: base64 -i service-account.json | tr -d '\n'
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Option B: point to a JSON file on disk instead (uses Google's standard ADC lookup).
# Leave FIREBASE_SERVICE_ACCOUNT_BASE64 empty if using this.
# GOOGLE_APPLICATION_CREDENTIALS=/etc/aurafit-backend/service-account.json
